{
  "name": "nexus-executor",
  "version": "1.0.0",
  "private": true,
  "description": "The Nexus executor — remote job runner for the hub: receives build jobs over authenticated HTTP (direct) or the gateway WebSocket and drives a local OpenCode V2 server in isolated git worktrees. 1.0.0 unifies the two diverged lineages (this repo's 0.3.x + the hub monorepo's 0.4/0.5): model policy, native personas, terminal-store sync, self-upgrades, discovery + project registry, per-run private test databases.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "migrate": "tsx --env-file=.env src/main.ts --migrate-only",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node --env-file=.env dist/main.js",
    "test": "vitest run",
    "cli": "tsx src/cli/cli.ts",
    "pair": "tsx src/cli/cli.ts pair",
    "harness:smoke": "tsx src/harness/smoke.ts",
    "repair": "tsx src/cli/cli.ts repair"
  },
  "bin": {
    "nexus-executor": "bin/nexus-executor"
  },
  "dependencies": {
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.5.0",
    "@langchain/langgraph-checkpoint-postgres": "1.1.0",
    "@langchain/openai": "1.6.2",
    "deepagents": "1.15.0",
    "fastify": "^5.6.1",
    "langchain": "1.5.16",
    "node-pty": "^1.1.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "ws": "^8.18.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5"
  }
}
