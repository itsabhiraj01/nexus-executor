{
  "name": "nexus-executor",
  "version": "0.2.0",
  "private": true,
  "description": "Standalone remote job runner for the Nexus hub — receives build jobs over authenticated HTTP and drives a local OpenCode V2 server in isolated git worktrees.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "migrate": "tsx --env-file=.env src/main.ts --migrate-only",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node --env-file=.env dist/main.js",
    "test": "vitest run",
    "pair": "tsx --env-file=.env src/pairing.ts"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5"
  }
}
