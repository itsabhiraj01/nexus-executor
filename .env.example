# ── Required ──────────────────────────────────────────────────────────────
# This executor's OWN Postgres database (never the hub's).
DATABASE_URL=postgres://nexus:nexus@localhost:5544/nexus_executor

# ── Where the OpenCode V2 server runs (required to actually run jobs) ────
# `opencode serve` on this machine. Pin its password on the service with
# OPENCODE_SERVER_PASSWORD so OPENCODE_TOKEN survives service restarts.
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# OPENCODE_TOKEN=the-opencode-server-password
# OPENCODE_AGENT=build

# ── Listen address ────────────────────────────────────────────────────────
# PORT=4099
# HOST=0.0.0.0
# LOG_LEVEL=info

# ── Identity ──────────────────────────────────────────────────────────────
# Shown on the hub next to jobs; defaults to the machine hostname.
# EXECUTOR_NAME=office-box
# The URL the hub should dial back. REQUIRED for pairing. Over a tailnet,
# use the machine's tailnet URL — plain HTTP inside a tailnet is fine.
# EXECUTOR_PUBLIC_URL=http://office.tailnet-xyz.ts.net:4099

# ── One-shot pairing inputs (consumed at boot, or via `make pair`) ───────
# HUB_URL=http://hub.tailnet-xyz.ts.net:3999
# PAIR_CODE=the-code-from-the-hub-ui

# ── Gateway transport (alternative to the dial-back listener) ────────────
# EXECUTOR_TRANSPORT=gateway turns this into an OUTBOUND-ONLY executor: it
# enrolls through the nexus-gateway service, then answers hub requests over
# a single WebSocket it holds open (via Cloudflare Tunnel). No listener, no
# EXECUTOR_PUBLIC_URL, NAT-friendly. PAIR_CODE is the enrollment token here.
# EXECUTOR_TRANSPORT=direct
# Public base URL of the deployed gateway (its Cloudflare hostname).
# GATEWAY_URL=https://executor-gateway.example.com
# Ed25519 identity + device credential store (mode 0600; delete to re-enroll).
# GATEWAY_IDENTITY_PATH=<workspace root>/../gateway-identity.json

# ── Workspaces ────────────────────────────────────────────────────────────
# Repos (cloned once per repoUrl) and per-job worktrees live here.
# EXECUTOR_WORKSPACE_ROOT=<cwd>/data/workspaces
# Branch job branches merge into; empty = the repo's own default branch.
# EXECUTOR_BASE_REF=
# Command run in the repo checkout after a merge; empty = no deploy.
# EXECUTOR_DEPLOY_COMMAND=

# ── Concurrency + polling ────────────────────────────────────────────────
# EXECUTOR_MAX_PARALLEL_JOBS=1
# EXECUTOR_POLL_INTERVAL_MS=2000

# ── Stall + timeout guards (minutes; 0 disables each) ────────────────────
# A single tool call running longer than this counts as stalled.
# EXECUTOR_TOOL_STALL_MINUTES=50
# An in-flight turn with zero session activity longer than this is stalled.
# EXECUTOR_STALL_MINUTES=20
# A tool whose output stopped changing for this long fails the job fast.
# EXECUTOR_TOOL_PROGRESS_MINUTES=10
# Hard ceiling for a started job (waiting_for_user is exempt).
# EXECUTOR_JOB_TIMEOUT_MINUTES=120

# ── In-job retries ────────────────────────────────────────────────────────
# Total attempts one job gets after a retryable failure (stalls, errored
# turns, timeouts, session-setup hiccups) when the hub's dispatch did not
# pin its own budget. 1 = fail on the first error (retries off).
# EXECUTOR_RETRY_MAX=3
# Minutes between a retryable failure and the requeued attempt.
# EXECUTOR_RETRY_DELAY_MINUTES=2
